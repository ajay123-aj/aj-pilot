# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------- web
PORT=4000
HOST=0.0.0.0

# ----------------------------------------------------------- database
# The MySQL database the panel stores everything in: servers, their system
# details, credentials, deployment projects and the activity log.
# The database is created automatically on first boot if it does not exist.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=auto_deploy
DB_POOL_SIZE=10

# ------------------------------------------------------------ secrets
# Master key used to encrypt every stored secret (server passwords, SSH keys,
# git/docker/cloudflare/mysql tokens) before it is written to the database.
# If unset, a random key is generated into data/master.key on first boot.
# Set it explicitly in production and BACK IT UP — losing it makes every
# stored credential unreadable.
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------- ssh
# Timeouts in milliseconds
SSH_CONNECT_TIMEOUT=15000
SSH_EXEC_TIMEOUT=45000

# ------------------------------------------------------- live view
# The Live tab holds one SSH session open per watcher and pushes a sample every
# few seconds. These cap how many may be open at once and how long one lasts
# before the browser reconnects.
STATS_MAX_STREAMS=8
STATS_STREAM_MINUTES=15

# ------------------------------------------------- connection monitor
# The panel opens a TCP connection to every server's SSH port on a short timer
# and flips its status to online / offline, so the list stays true without
# pressing "Test". No handshake, no login — just "does the port answer".
HEALTH_CHECK_INTERVAL_SECONDS=5
# How long that connection may take before the host counts as offline (ms).
HEALTH_CHECK_TIMEOUT=4000
# How many servers are probed at the same time.
HEALTH_CHECK_CONCURRENCY=10
# Separately, and far less often, the panel actually signs in — the only way to
# know the stored credentials still work. Minutes between sign-in checks.
HEALTH_CHECK_SIGNIN_MINUTES=10
HEALTH_CHECK_SIGNIN_TIMEOUT=12000
# Set to false to turn the whole thing off.
HEALTH_CHECK_ENABLED=true

# ---------------------------------------------------------------- sign-in
# How long a sign-in lasts before it has to be repeated.
AUTH_SESSION_DAYS=14
# Set to true once the panel is served over HTTPS, so the session cookie is
# only ever sent over an encrypted connection.
AUTH_SECURE_COOKIE=false

# Super admin (platform owner). When both email and password are set, every start
# makes sure this account exists, is an active super admin, and signs in with this
# password (at least 10 characters, letters and numbers). Change it here + restart.
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform Owner
# Mobile number with country code (optional here — without it you are asked at sign-in).
SUPER_ADMIN_PHONE=

# Public address of this site, used in the page's canonical link, sitemap.xml
# and social link previews. Leave empty to use whatever address it is visited at.
SITE_URL=

# Where a lead's IP address is looked up to show its city, country and internet
# provider: "ipwho.is" (default, free, no key) or "off". Behind Cloudflare its
# location headers are used first and no lookup is needed.
GEOIP=ipwho.is
