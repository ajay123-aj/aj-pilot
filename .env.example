# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------- web
PORT=4000
HOST=0.0.0.0

# ----------------------------------------------------------- database
# The MySQL database the panel stores everything in: servers, their system
# details, credentials, deployment projects and the activity log.
# The database is created automatically on first boot if it does not exist.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=auto_deploy
DB_POOL_SIZE=10

# ------------------------------------------------------------ secrets
# Master key used to encrypt every stored secret (server passwords, SSH keys,
# git/docker/cloudflare/mysql tokens) before it is written to the database.
# If unset, a random key is generated into data/master.key on first boot.
# Set it explicitly in production and BACK IT UP — losing it makes every
# stored credential unreadable.
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------- ssh
# Timeouts in milliseconds
SSH_CONNECT_TIMEOUT=15000
SSH_EXEC_TIMEOUT=45000

# ------------------------------------------------------- live view
# The Live tab holds one SSH session open per watcher and pushes a sample every
# few seconds. These cap how many may be open at once and how long one lasts
# before the browser reconnects.
STATS_MAX_STREAMS=8
STATS_STREAM_MINUTES=15

# ------------------------------------------------- connection monitor
# The panel opens a TCP connection to every server's SSH port on a short timer
# and flips its status to online / offline, so the list stays true without
# pressing "Test". No handshake, no login — just "does the port answer".
HEALTH_CHECK_INTERVAL_SECONDS=5
# How long that connection may take before the host counts as offline (ms).
HEALTH_CHECK_TIMEOUT=4000
# How many servers are probed at the same time.
HEALTH_CHECK_CONCURRENCY=10
# Separately, and far less often, the panel actually signs in — the only way to
# know the stored credentials still work. Minutes between sign-in checks.
HEALTH_CHECK_SIGNIN_MINUTES=10
HEALTH_CHECK_SIGNIN_TIMEOUT=12000
# Set to false to turn the whole thing off.
HEALTH_CHECK_ENABLED=true

# ---------------------------------------------------------------- sign-in
# How long a sign-in lasts before it has to be repeated.
AUTH_SESSION_DAYS=14
# Set to true once the panel is served over HTTPS, so the session cookie is
# only ever sent over an encrypted connection (it also turns on HSTS). Left
# empty, it follows SITE_URL: on when that starts with https://.
AUTH_SECURE_COOKIE=

# Set to true only when a reverse proxy (nginx, Cloudflare tunnel) sits in front
# of the panel. Then X-Forwarded-For / CF-Connecting-IP are trusted as the
# visitor's address (rate limits, lead locations). Left false, they are ignored,
# because anyone can send those headers.
TRUST_PROXY=false

# May the panel itself dial private addresses (127.0.0.1, 10.x, 192.168.x,
# 169.254.169.254 …) when testing a database or server connection that does not
# go through a server or connector? "block" for a panel with public sign-up,
# "allow" for a private panel managing machines on its own LAN. Empty: allowed
# only while ALLOW_SIGNUP=false.
PRIVATE_TARGETS=

# Super admin (platform owner). When both email and password are set, every start
# makes sure this account exists, is an active super admin, and signs in with this
# password (at least 10 characters, letters and numbers). Change it here + restart.
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform Owner
# Mobile number with country code (optional here — without it you are asked at sign-in).
SUPER_ADMIN_PHONE=

# Public address of this site, used in the page's canonical link, sitemap.xml
# and social link previews. Leave empty to use whatever address it is visited at.
SITE_URL=

# Where a lead's IP address is looked up to show its city, country and internet
# provider: "ipwho.is" (default, free, no key) or "off". Behind Cloudflare its
# location headers are used first and no lookup is needed.
GEOIP=ipwho.is

# One-time code asked for at every sign-in and sign-up, sent to the mobile number
# (or the email, for an account with no number). "fixed" accepts OTP_FIXED_CODE
# for everyone — for testing, until an SMS provider is connected. "random" makes a
# new code each time and, with no provider yet, writes it to the server log.
OTP_MODE=fixed
OTP_FIXED_CODE=123456
OTP_MINUTES=10
# "Mobile & OTP" on the sign-in card: a mobile number and a code, no password.
# The code is then the only proof, so it is off while OTP_MODE=fixed (anyone can
# type the fixed code) and on with OTP_MODE=random. "on" / "off" overrides that —
# set OTP_LOGIN=on only to try it out with the fixed test code.
OTP_LOGIN=

# Outgoing email: the "verify your email" link sent after sign-up. Without
# SMTP_HOST the message (and its link) is written to the server log instead.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (TLS from the start); false for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AJ Pilot <no-reply@example.com>
# How long a verification link works.
EMAIL_VERIFY_HOURS=24

# Razorpay — paying for a plan online. From the Razorpay dashboard: Account &
# Settings → API Keys (use the rzp_test_ keys while testing). With both set, a
# paid plan opens Razorpay Checkout and starts as soon as the payment is
# verified. Left empty, a paid plan is a request a super admin switches on.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended: Settings → Webhooks → add <SITE_URL>/api/hooks/razorpay
# with the "payment.captured" and "order.paid" events and this secret. It switches
# the plan on even when the buyer closes the tab before Checkout returns.
RAZORPAY_WEBHOOK_SECRET=

# Visitors  can create their own account (their own organisation, on the free plan). Set to false to turn sign-up off.
ALLOW_SIGNUP=true

# The free plan is a trial: it lasts this many days, once per organisation. After that everything is view-only until a paid plan.
FREE_TRIAL_DAYS=30
